# ═══════════════════════════════════════════════════════════════
# INSOPHINIA POS — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values below
#   3. NEVER commit .env to Git — it contains secrets!
# ═══════════════════════════════════════════════════════════════


# ─── Application ──────────────────────────────────────────────

# Comma-separated list of URLs where the app is accessible.
# Include localhost AND your LAN IP if testing on mobile devices.
# Example: "http://localhost:3000,http://192.168.1.100:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Environment mode: "development" | "production"
# "development" = verbose error messages, slower but debuggable.
# "production"  = optimized, errors are hidden from users.
NODE_ENV="development"


# ─── Database (PostgreSQL) ────────────────────────────────────

# Pooled connection string — used at runtime by the application.
# If using Supabase, use port 6543 with pgbouncer=true.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?options
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true&statement_cache_size=0"

# Direct connection string — used ONLY for Prisma migrations (npx prisma db push).
# Same credentials but port 5432 (direct, no pooling).
DIRECT_URL="postgresql://user:password@host:5432/database"


# ─── Supabase S3-Compatible Storage (Restricted Backups) ──────
# Found in: Supabase Dashboard → Project Settings → Storage → S3 Connection
# Endpoint Example: https://[PROJECT-REF].supabase.co/storage/v1/s3

S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_REGION="ap-south-1" 
S3_ENDPOINT="https://your-project-id.supabase.co/storage/v1/s3"
BUCKET_NAME="pos_backups"


# ─── Authentication ───────────────────────────────────────────

# Secret key used to sign JWT login tokens. Must be long and random.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_64_char_hex_string"

# How long a login session lasts before the user must log in again.
# Value in seconds. Examples: 3600 = 1 hour, 86400 = 24 hours.
JWT_EXPIRATION="3600"

# Number of bcrypt hashing rounds for passwords. Higher = slower but more secure.
# Recommended: 12 (default). Range: 10–14.
BCRYPT_ROUNDS="12"

# Days before a user's password expires and must be changed.
# Set to a high number (e.g., 365) to effectively disable.
PASSWORD_EXPIRY_DAYS="7"


# ─── Encryption Keys ─────────────────────────────────────────
# These keys encrypt sensitive data. Losing them = losing access to encrypted data.
# Generate each one separately — DO NOT reuse the same key!

# Encrypts 2FA (TOTP) secrets stored in the database.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY="CHANGE_ME_generate_a_64_char_hex_string"

# Encrypts sensitive system log entries (failed logins, security events).
# Can be any string; longer is more secure.
LOG_ENCRYPTION_KEY="CHANGE_ME_any_secure_string"

# Encrypts cloud backup files using AES-256-GCM. Must be exactly 32 characters.
# Generate:  node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
BACKUP_ENCRYPTION_KEY="CHANGE_ME_exactly_32_characters!"


# ─── Feature Flags ────────────────────────────────────────────

# Master toggle for email sending. "true" = receipts can be emailed to customers.
# You must also configure the SMTP settings below if enabling this.
EMAIL_ENABLED="false"

# Bind sessions to the user's IP address. "true" = more secure but may cause
# issues on mobile networks where IP addresses change frequently.
REQUIRE_IP_PINNING="false"


# ─── Email / SMTP (only needed if EMAIL_ENABLED="true") ──────
# For Gmail:   HOST=smtp.gmail.com   PORT=587   PASSWORD=App Password (not your real password)
# For Outlook: HOST=smtp.office365.com   PORT=587

EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USERNAME="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="INSOPHINIA POS <noreply@yourdomain.com>"


# ─── Rate Limiting & Security ─────────────────────────────────

# Maximum API requests allowed per time window (per IP address).
# Prevents abuse and brute-force attacks. Default: 100.
RATE_LIMIT_MAX="100"

# Time window for rate limiting, in milliseconds.
# Default: 60000 (1 minute). So 100 requests per minute per IP.
RATE_LIMIT_WINDOW_MS="60000"

# Maximum allowed request body size in bytes. Blocks oversized payloads.
# Default: 1048576 (1 MB). Increase if you upload large files.
MAX_REQUEST_BODY_SIZE="1048576"

# Comma-separated list of origins allowed to call the API (CORS policy).
# Must include every URL where the app is served from.
# Example: "http://localhost:3000,https://pos.mybusiness.com"
ALLOWED_ORIGINS="http://localhost:3000"

# ─── Automated Backups ─────────────────────────────────────────
# Vercel Cron Secret for Automated Backups. Must match the variable set in Vercel dashboard.
CRON_SECRET="your_secure_cron_secret_here"
